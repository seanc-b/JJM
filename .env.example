# Copy to .env.local and fill in. Never commit real keys.

# Google Maps JavaScript API key for the brand-styled map on the Contact page (src/components/BrandMap.tsx).
# Without it the page shows Google's plain map embed instead.
# Restrict the key in Google Cloud: Application restrictions -> Websites (your domains and localhost:3000),
# API restrictions -> Maps JavaScript API only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
